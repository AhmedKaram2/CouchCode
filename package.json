{
  "name": "couchcode",
  "version": "1.6.0",
  "description": "Code from your couch - Control your terminal remotely from any device",
  "main": "src/main/main.js",
  "author": "Ahmed Karam",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmedKaram2/CouchCode.git"
  },
  "bugs": {
    "url": "https://github.com/AhmedKaram2/CouchCode/issues"
  },
  "homepage": "https://github.com/AhmedKaram2/CouchCode#readme",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "rebuild": "electron-rebuild -f -w node-pty",
    "rebuild:win": "electron-rebuild -f -w node-pty -p win32",
    "rebuild:linux": "electron-rebuild -f -w node-pty -p linux",
    "icons": "node scripts/generate-icons.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "installer": "node scripts/build.js",
    "installer:win": "node scripts/build.js win",
    "installer:mac": "node scripts/build.js mac",
    "installer:linux": "node scripts/build.js linux",
    "installer:all": "node scripts/build.js all",
    "dist": "npm run icons && npm run build",
    "dist:win": "npm run icons && npm run build:win",
    "dist:mac": "npm run icons && npm run build:mac",
    "dist:linux": "npm run icons && npm run build:linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "com.ahmedkaram.couchcode",
    "productName": "CouchCode",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/",
        "to": "build/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Terminal Remote"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "Terminal Remote",
      "synopsis": "Control your terminal remotely",
      "description": "Control your terminal remotely from any device with a web browser"
    }
  }
}
